@startuml
left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho

package "Vue (View)" {
  class InterfaceUtilisateur {
    +afficherFormulaire()
    +afficherMessage()
    +afficherConfirmation()
  }
}

package "Contrôleur (Controller)" {
  class ReservationController {
    +ajouterReservation()
    +annulerReservation()
    +consulterReservation()
    +consulterHistoriqueReservation()
    +modifierReservation()
  }

  class ChambreController {
    +ajouterChambre()
    +annulerChambre()
    +modifierChambre()
    +consulterChambre()
  }

  class ClientController {
    +ajouterClient()
    +annulerClient()
    +consulterClient()
  }
}

package "Modèle (Model)" {
  class Reservation {
    -dateDebut : Date
    -dateFin : Date
    -montant : float
    +calculerMontant()
  }

  class Client {
    -nom : string
    -prenom : string
    -email : string
  }

  class Chambre {
    -numero : int
    -type : string
    -etat : string
    -prix : float
  }

  class Admin {
    -nom : string
    -prenom : string
    -email : string
  }
}

' Relations entre les couches
InterfaceUtilisateur --> ReservationController : actions utilisateur
InterfaceUtilisateur --> ChambreController
InterfaceUtilisateur --> ClientController

ReservationController --> Reservation : gère
ReservationController --> Client
ReservationController --> Chambre

ChambreController --> Chambre : gère

ClientController --> Client : gère
Admin --> "Contrôleur (Controller)" 

' Le contrôleur met à jour la vue
ReservationController --> InterfaceUtilisateur : mise à jour vue
ChambreController --> InterfaceUtilisateur
ClientController --> InterfaceUtilisateur

@endum
